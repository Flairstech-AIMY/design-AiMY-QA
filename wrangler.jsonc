{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aimyqa",
  "compatibility_date": "2026-08-03",
  "observability": {
    "enabled": true
  },
  /* The site is built into dist/ (scripts/build-site.mjs copies the pages,
     assets/ and design-strategy/), so tooling at the repo root, node_modules
     included, is never uploaded. Wrangler runs the build before every
     deploy, from Cloudflare's builder or from a manual `npx wrangler deploy`. */
  "build": {
    "command": "node scripts/build-site.mjs"
  },
  "assets": {
    "directory": "./dist"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
