# What `wrangler deploy` must not publish. The assets directory is the repo
# root, so without this the git history, local tool settings, npm files and
# dev-only sources would be served to anyone who asks for them.
.git
.gitignore
.assetsignore
.claude
.wrangler
.dev.vars*
.env*
.nvm
.nvmrc
.storybook
stories
node_modules
package.json
package-lock.json
wrangler.jsonc
README.md

# Vendored tools and local agent material (AGENTS.md: "not examples of the
# product app"). Some are committed, some exist only in a local working copy;
# either way they are tooling, not the site, and must not be published.
agent-skills
ui-ux-pro-max-skill
custom-icons-skill
.agents
.aider-desk
.impeccable
AGENTS.md
findings.txt
skills-lock.json
storybook-static
